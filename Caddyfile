{
    frankenphp
}

:80 {
    root * /app/public
    encode zstd br gzip

    # Pastikan /livewire/* tidak ditangani sebagai static file
    @livewire path /livewire/*
    handle @livewire {
        rewrite * /index.php?{query}
    }

    # Tangani file statis secara eksplisit agar disajikan langsung oleh web server
    @static {
        file
        path *.css *.js *.svg *.png *.jpg *.jpeg *.ico *.woff *.woff2 *.webp *.gif *.pdf *.map
    }
    handle @static {
        file_server
    }

    php_server
}
